# Copy to .env and fill in real values. Never commit .env itself.

# Database. Local dev/tests use SQLite (the committed schema provider).
DATABASE_URL="file:./dev.db"
# For PRODUCTION on PostgreSQL:
#   1) npm run db:postgres         # flips the Prisma datasource to postgresql
#   2) set DATABASE_URL below to your Postgres connection string
#   3) npx prisma db push          # (the checked-in migrations are SQLite-only)
# DATABASE_URL="postgresql://user:pass@host:5432/education_hub?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=3000
NODE_ENV=development

# Optional: plug a LOCAL AI agent into the in-app help chat (see README
# "Plugging in an AI agent"). Leave unset to use the built-in rule-based
# knowledge base. The command gets the question appended as its final
# argument and must print a plain-text answer to stdout.
# CHAT_AGENT_CMD=python3 /path/to/your/agent.py --ask
# CHAT_AGENT_TIMEOUT_MS=30000

# Notifications (Phase 1). All optional — with nothing set, in-app
# notifications still work and email/SMS are simply skipped.
# Public app URL used to build links (e.g. invite join links):
# APP_URL=http://localhost:5173
# Email via SMTP. Either a single URL...
# SMTP_URL=smtps://user:pass@smtp.example.com
# ...or discrete settings:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# MAIL_FROM=Education Hub <no-reply@yourschool.edu>
# Optional pluggable SMS backend (same contract style as CHAT_AGENT_CMD):
# recipient and message are appended as the final two args. Off by default.
# SMS_CMD=python3 /path/to/send_sms.py
# SMS_TIMEOUT_MS=15000

# Safety & Privacy (Phase 7). All optional and off by default — the built-in
# text scanner always runs; these add file-level protection via LOCAL tools.
# The file path is appended as the final argument (run without a shell).
# Malware/AV scan — ClamAV-style contract (exit 1 + "... FOUND" = infected):
# AV_SCAN_CMD=clamdscan --no-summary --fdpass
# AV_SCAN_TIMEOUT_MS=30000
# Image classifier — must print one line: "clean" | "flagged: <label>" | "review: <label>"
# IMAGE_SCAN_CMD=python3 /path/to/nsfw_classify.py
# IMAGE_SCAN_TIMEOUT_MS=30000
